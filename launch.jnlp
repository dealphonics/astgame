<?xml version="1.0" encoding="utf-8"?>
<jnlp spec="1.0+" codebase="https://dealphonics.github.io/astgame/" href="launch.jnlp">
    <information>
        <title>Voxel Asteroid Engine</title>
        <vendor>Java OpenWebStart Game</vendor>
        <description>3D Воксельный астероид на LWJGL</description>
    </information>
    
    <security>
        <all-permissions/>
    </security>
    
    <resources>
        <j2se version="17+" max-heap-size="4096m"/>
        <jar href="asteroid-game-v1.jar" main="true"/>
    </resources>
    
    <application-desc main-class="com.voxel.VoxelAsteroidGame"/>
</jnlp>
