<?xml version="1.0" encoding="utf-8"?>
<jnlp spec="1.0+" codebase="https://dealphonics.github.io/astgame/">
    <information>
        <title>Voxel Asteroid Engine</title>
        <vendor>dealphonics</vendor>
        <description>3D Игра запущенная через GitHub и OpenWebStart</description>
    </information>
    <resources>
        <j2se version="17+" max-heap-size="4096m"/>
        <jar href="asteroid-game.jar" main="true"/>
    </resources>
    <application-desc main-class="com.voxel.VoxelAsteroidGame"/>
</jnlp>
